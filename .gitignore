# ---------------------------------------------------------------------------
# Third-party raw downloads: re-creatable, and not part of the source project.
# See data/README.md for the exact sources and versions, and tools/ for the
# scripts that fetch them again.
# ---------------------------------------------------------------------------

# The HYG catalogue itself (13 MB compressed / 32 MB decompressed).
# Re-fetch with tools/ghblob.js, then decompress with tools/gunzip_hyg.py
data/raw/hygdata_v40.csv
data/raw/hygdata_v40.csv.gz
data/raw/*.csv
data/raw/*.csv.gz

# Packages already unpacked from the archives below
data/raw/extracted/

# Solar-system source data, re-fetchable (see data/solar-system.md)
#   node tools/download.js https://www.minorplanetcenter.net/iau/Ephemerides/Comets/Soft00AllCmt.txt data/raw/CometElsAll.txt
data/raw/CometEls.txt
data/raw/CometElsAll.txt
data/raw/comets*.json

# Downloaded archives of third-party packages (three.js, d3-celestial, ...)
data/raw/*.tgz
data/raw/*.zip

# ---------------------------------------------------------------------------
# Build / deploy artifacts: generated by tools/zip-site.mjs, never source.
# The site itself lives in web/ — these are copies of it.
# ---------------------------------------------------------------------------
star-map-site.zip
star-map-site/

